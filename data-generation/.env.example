# Copiar este archivo a ".env" (que está en .gitignore) y completar valores
# reales. Usado tanto por docker-compose.yml (Postgres local) como por
# load_to_postgres.py.

# --- Postgres local (Docker) ---
POSTGRES_USER=finbank
POSTGRES_PASSWORD=changeme_local_dev_only
POSTGRES_DB=finbank

# --- Usados por load_to_postgres.py ---
# Para desarrollo local con docker-compose, deja host=localhost y usa los
# mismos valores de arriba. Para apuntar a Cloud SQL, cambia host/port y
# saca la password del Secret Manager (nunca la escribas en un commit).
FINBANK_DB_HOST=localhost
FINBANK_DB_PORT=5434
FINBANK_DB_NAME=finbank
FINBANK_DB_USER=finbank
FINBANK_DB_PASSWORD=changeme_local_dev_only
